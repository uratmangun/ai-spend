{
  "name": "Next.js with Adapter",
  "description": "Integrate xmcp into a Next.js application using the adapter",
  "keywords": [
    "nextjs",
    "adapter"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS=\"--require ./scripts/force-zod3.cjs\" xmcp dev & NODE_OPTIONS=\"--require ./scripts/force-zod3.cjs\" next dev",
    "dev:turbo": "NODE_OPTIONS=\"--require ./scripts/force-zod3.cjs\" xmcp dev & NODE_OPTIONS=\"--require ./scripts/force-zod3.cjs\" next dev --turbo",
    "build": "NODE_OPTIONS=\"--require ./scripts/force-zod3.cjs\" xmcp build && NODE_OPTIONS=\"--require ./scripts/force-zod3.cjs\" next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.41",
    "@base-org/account": "^2.2.0",
    "@farcaster/jfs": "^0.0.6",
    "@farcaster/miniapp-sdk": "^0.1.10",
    "@google/genai": "^1.17.0",
    "@rainbow-me/rainbowkit": "^2.2.8",
    "@tanstack/react-query": "^5.87.4",
    "ai": "^5.0.39",
    "dotenv": "^17.2.2",
    "ethers": "^6.15.0",
    "jimp": "^1.6.0",
    "mime": "^4.0.7",
    "next": "15.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.5",
    "viem": "^2.37.5",
    "wagmi": "^2.16.9",
    "xmcp": "^0.2.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "swc-loader": "^0.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "packageExtensions": {
      "xmcp@*": {
        "dependencies": {
          "zod": "^3.24.4"
        },
        "peerDependencies": {
          "zod": "^3.22.4"
        }
      }
    },
    "overrides": {
      "xmcp>zod": "^3.24.4"
    }
  }
}
