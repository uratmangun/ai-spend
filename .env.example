CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
PAT_TOKEN=your_personal_access_token
FARCASTER_FID=your_farcaster_fid
FARCASTER_CUSTODY_ADDRESS=your_farcaster_custody_address
FARCASTER_CUSTODY_PRIVATE_KEY=your_farcaster_custody_private_key
TOGETHER_API_KEY=your_together_api_key
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
NEXT_PUBLIC_APP_DOMAIN=your_app_domain
SCREENSHOT_URL=your_screenshot_url
BROWSERLESS_API_URL=your_browserless_api_url
NEYNAR_API_KEY=your_neynar_api_key
FARCASTER_BEARER_TOKEN=your_farcaster_bearer_token
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEY=your_gemini_api_key
AI_GATEWAY_API_KEY=your_api_key_here
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# CDP SDK Configuration
CDP_API_KEY_ID=your-api-key-id
CDP_API_KEY_SECRET=your-api-key-secret
CDP_WALLET_SECRET=your-wallet-secret

# CDP Node RPC (for JSON-RPC like eth_getBalance)
# Option A: Provide a client API key (safe for client-side per CDP docs)
CDP_CLIENT_API_KEY=your-cdp-client-api-key
# Or, if you prefer exposing on the client explicitly
NEXT_PUBLIC_CDP_CLIENT_API_KEY=your-cdp-client-api-key
# Option B: Provide full RPC URLs (include your client key at the end)
# Base Sepolia (testnet)
CDP_RPC_URL_BASE_SEPOLIA=https://api.developer.coinbase.com/rpc/v1/base-sepolia/your-cdp-client-api-key
# Base (mainnet)
CDP_RPC_URL_BASE=https://api.developer.coinbase.com/rpc/v1/base/your-cdp-client-api-key

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Zora Configuration
ZORA_API_KEY=your-zora-api-key

# Base Network Configuration
NEXT_PUBLIC_BASE_CHAIN_ID=8453
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Paymaster
PAYMASTER_URL=paymaster_url